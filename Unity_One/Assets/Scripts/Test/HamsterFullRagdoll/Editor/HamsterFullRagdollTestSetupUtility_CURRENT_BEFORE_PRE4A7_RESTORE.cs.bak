    private static Transform FindPhase4a4VisualPreviewRoot(Transform bodyTransform, HamsterVisualFollower visualFollower)
    {
        Transform visualRoot = FindDirectChild(bodyTransform, JointFreeShellVisualRootName);
        if (visualRoot != null)
            return visualRoot;

        Transform[] descendants = bodyTransform.GetComponentsInChildren<Transform>(true);
        for (int i = 0; i < descendants.Length; i++)
        {
            Transform candidate = descendants[i];
            if (candidate != null && string.Equals(candidate.name, JointFreeShellVisualRootName, StringComparison.Ordinal))
                return candidate;
        }

        if (visualFollower == null)
            return null;

        SerializedObject followerObject = new SerializedObject(visualFollower);
        Transform assignedVisualRoot = GetObjectReference<Transform>(followerObject, "visualRoot");
        if (assignedVisualRoot != null && IsChildOf(assignedVisualRoot, bodyTransform))
            return assignedVisualRoot;

        return null;
    }

    private static Animator ResolvePhase4a4VisualAnimator(Transform visualRoot, HamsterVisualFollower visualFollower)
    {
        Animator visualAnimator = visualRoot != null ? visualRoot.GetComponentInChildren<Animator>(true) : null;
        if (visualAnimator != null)
            return visualAnimator;

        if (visualFollower == null)
            return null;

        SerializedObject followerObject = new SerializedObject(visualFollower);
        visualAnimator = GetObjectReference<Animator>(followerObject, "visualAnimator");
        if (visualAnimator != null)
            Debug.LogWarning($"{LogPrefix} Using existing HamsterVisualFollower.visualAnimator because no Animator was found under VisualPreviewRoot.");

        return visualAnimator;
    }

