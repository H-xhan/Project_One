    private static bool ApplyPhase4a7RagdollFeelLocomotionPreset(Scene scene)
    {
        if (!scene.IsValid()
            || !string.Equals(NormalizeAssetPath(scene.path), SceneDestinationPath, StringComparison.OrdinalIgnoreCase))
        {
            Debug.LogWarning($"{LogPrefix} Current scene is not the destination test scene. Open {SceneDestinationPath} first. CurrentPath={scene.path}");
            return false;
        }

        GameObject shellRoot = FindGameObjectByName(scene, JointFreeShellRootName);
        if (shellRoot == null)
        {
            Debug.LogWarning($"{LogPrefix} {JointFreeShellRootName} not found. Run Create Phase 1 Joint-Free Motor Shell first.");
            return false;
        }

        if (!shellRoot.activeInHierarchy)
            Debug.LogWarning($"{LogPrefix} {JointFreeShellRootName} is inactive. Phase 4a-7 does not change GameObject active state.");

        Transform bodyTransform = FindDirectChild(shellRoot.transform, JointFreeShellBodyName);
        if (bodyTransform == null)
        {
            Debug.LogError($"{LogPrefix} {JointFreeShellBodyName} is missing under {JointFreeShellRootName}.");
            return false;
        }

        Rigidbody bodyRigidbody = bodyTransform.GetComponent<Rigidbody>();
        if (bodyRigidbody == null)
        {
            Debug.LogError($"{LogPrefix} MotorShellBody Rigidbody is missing.");
            return false;
        }

        HamsterFullRagdollMotor motor = bodyTransform.GetComponent<HamsterFullRagdollMotor>();
        if (motor == null)
        {
            Debug.LogError($"{LogPrefix} MotorShellBody HamsterFullRagdollMotor is missing.");
            return false;
        }

        HamsterVisualFollower visualFollower = bodyTransform.GetComponent<HamsterVisualFollower>();
        if (visualFollower == null)
        {
            Debug.LogError($"{LogPrefix} MotorShellBody HamsterVisualFollower is missing. Run Configure Visual Follower For Joint-Free Shell first.");
            return false;
        }

        Transform visualRoot = FindDirectChild(bodyTransform, JointFreeShellVisualRootName);
        if (visualRoot == null)
        {
            Debug.LogError($"{LogPrefix} {JointFreeShellVisualRootName} was not found as a direct child of {JointFreeShellBodyName}.");
            return false;
        }

        Animator visualAnimator = visualRoot.GetComponentInChildren<Animator>(true);
        if (visualAnimator == null)
        {
            Debug.LogError($"{LogPrefix} First Animator under {JointFreeShellVisualRootName} was not found.");
            return false;
        }

        Component clipStateDriver = GetComponentByTypeName(bodyTransform.gameObject, "HamsterVisualClipStateDriver");
        if (clipStateDriver == null)
            Debug.LogWarning($"{LogPrefix} HamsterVisualClipStateDriver not found on MotorShellBody. Nothing to disable.");
        else
            SetBehaviourEnabled(clipStateDriver, false, "HamsterVisualClipStateDriver");

        Component proceduralPoseController = GetComponentByTypeName(bodyTransform.gameObject, "HamsterProceduralPoseController");
        if (proceduralPoseController == null)
            Debug.LogWarning($"{LogPrefix} HamsterProceduralPoseController not found on MotorShellBody. Phase 4a-7 ragdoll-feel pose assist cannot be enabled automatically.");
        else
            SetBehaviourEnabled(proceduralPoseController, true, "HamsterProceduralPoseController");

        SetBehaviourEnabled(visualFollower, true, "HamsterVisualFollower");
        SetPhase4a7AnimatorEnabledAndRootMotion(visualAnimator);

        ApplyPhase4a7MotorSerializedFields(motor, bodyRigidbody);
        ApplyPhase4a7VisualFollowerSerializedFields(visualFollower, bodyRigidbody, visualRoot, visualAnimator, motor);

        EditorUtility.SetDirty(bodyTransform.gameObject);
        EditorUtility.SetDirty(motor);
        EditorUtility.SetDirty(visualFollower);
        EditorUtility.SetDirty(visualAnimator);

        Debug.Log($"{LogPrefix} Phase 4a-7 preset applied to scene instance: body={GetHierarchyPath(bodyTransform)} visualRoot={GetHierarchyPath(visualRoot)} animator={GetHierarchyPath(visualAnimator.transform)}");
        Debug.LogWarning($"{LogPrefix} AnimatorController asset was not modified. AnimationClip, FBX, prefab, scene save, Rigidbody movement, and production code were not modified.");
        return true;
    }

