        SetFloatField(motorObject, "landingVisualIntensity", 1.0f);

        motorObject.ApplyModifiedProperties();
        EditorUtility.SetDirty(motor);
        Debug.Log($"{LogPrefix} Phase 4a-6 Motor preset applied. Rigidbody values were not modified. body={GetHierarchyPath(bodyRigidbody.transform)}");
        Debug.Log($"{LogPrefix} Phase 4a-6 expected motor sprint log: selectedMaxSpeed around {Phase4a6MaxSprintSpeed:F1}, selectedAcceleration around {Phase4a6SprintAcceleration:F0}.");
    }

