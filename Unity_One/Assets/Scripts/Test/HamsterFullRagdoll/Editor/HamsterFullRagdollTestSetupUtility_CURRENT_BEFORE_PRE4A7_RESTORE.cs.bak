    private static void DisablePhase4a4ProceduralPoseController(GameObject body)
    {
        Component proceduralPoseController = GetComponentByTypeName(body, "HamsterProceduralPoseController");
        if (proceduralPoseController == null)
        {
            Debug.Log($"{LogPrefix} HamsterProceduralPoseController not found on MotorShellBody.");
            return;
        }

        SetBehaviourEnabled(proceduralPoseController, false, "HamsterProceduralPoseController");
    }

    private static void SetGameObjectActive(GameObject target, bool active, string label)
    {
        if (target == null)
            return;

        Undo.RecordObject(target, $"Set {label} active={active}");
        if (target.activeSelf != active)
            target.SetActive(active);

        EditorUtility.SetDirty(target);
        Debug.Log($"{LogPrefix} {label} activeSelf={target.activeSelf} activeInHierarchy={target.activeInHierarchy}");
    }

    private static void SetBehaviourEnabled(Component component, bool enabled, string label)
    {
        Behaviour behaviour = component as Behaviour;
        if (behaviour == null)
        {
            Debug.LogWarning($"{LogPrefix} {label} is not a Behaviour and cannot be enabled/disabled automatically.");
            return;
        }

        Undo.RecordObject(behaviour, $"Set {label} enabled={enabled}");
        behaviour.enabled = enabled;
        EditorUtility.SetDirty(behaviour);
        Debug.Log($"{LogPrefix} {label} enabled={behaviour.enabled}");
    }

