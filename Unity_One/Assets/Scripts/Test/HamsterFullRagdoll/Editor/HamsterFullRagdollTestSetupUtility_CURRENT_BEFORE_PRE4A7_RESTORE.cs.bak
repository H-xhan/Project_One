        SetFloatField(motorObject, "sprintPivotDotThreshold", Phase4aSprintPivotDotThreshold);
        SetFloatField(motorObject, "sprintPivotAccelerationMultiplier", Phase4a6SprintPivotAccelerationMultiplier);
        SetFloatField(motorObject, "sprintPivotMinPlanarSpeed", Phase4aSprintPivotMinPlanarSpeed);
        SetBoolField(motorObject, "debugSprintPivotLogs", true);

