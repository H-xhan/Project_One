        SetFloatField(motorObject, "landingLogMinVerticalSpeed", Phase4a4LandingLogMinVerticalSpeed);
        SetBoolField(motorObject, "debugJumpLogs", false);

        AssignObjectField(motorObject, "visualFollower", visualFollower, required: false);
        SetBoolField(motorObject, "autoFindVisualFollower", true);
        SetFloatField(motorObject, "jumpVisualIntensity", 1.0f);
        SetFloatField(motorObject, "landingVisualIntensity", 1.0f);

        motorObject.ApplyModifiedProperties();
        EditorUtility.SetDirty(motor);
        Debug.Log($"{LogPrefix} Phase 4a-4 Motor preset applied. Rigidbody values were not modified. body={GetHierarchyPath(bodyRigidbody.transform)}");
    }

